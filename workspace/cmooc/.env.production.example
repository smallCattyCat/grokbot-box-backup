# Copy this file to .env on the server, then fill only the values needed by your experiment.
DATABASE_URL="file:/data/dev.db"
NEXT_PUBLIC_APP_URL="https://your-domain.example"
APP_ORIGIN="https://your-domain.example"
# Public white-label surface for a single-customer deployment. These values do
# not alter connector bindings or release any write capability.
NEXT_PUBLIC_PRODUCT_NAME="课程共创智能体"
NEXT_PUBLIC_PRODUCT_SHORT_NAME="课程智能体"
NEXT_PUBLIC_PRODUCT_DESCRIPTION="面向课程互动网络、运行证据与协作研判的课程运营工作台"
NEXT_PUBLIC_OPERATOR_LABEL="课程运营团队"
COURSE_MANIFEST_DIR="/data/course-manifests"
LLM_MODE="mock"
LLM_BASE_URL=""
LLM_API_KEY=""
LLM_MODEL=""
CMOOC_ALLOWED_FORUM_ORIGINS=""
LLM_TIMEOUT_MS="60000"
DASHSCOPE_COMPATIBLE_BASE_URL="https://dashscope.aliyuncs.com/compatible-mode/v1"
DASHSCOPE_MODEL="qwen3.7-plus"

# Optional cMOOC experiment-platform integration.
REAL_FORUM_LOGIN_URL=""
CMOOC_SATOKEN=""
CMOOC_COURSE_ID=""
CMOOC_COLUMN_ID=""
SCREENSHOT_DIR="/data/screenshots"
