# Copy to .env only after reviewing the host-specific values.
# The portable service also forces its own loopback origin and mock LLM mode.
CMOOC_SERVICE_HOST=127.0.0.1
CMOOC_SERVICE_PORT=3050
CMOOC_SERVICE_DATA_DIR=/data/cmooc-service-data
DATABASE_URL=file:/data/cmooc-service-data/course.db
CMOOC_WORKBENCH_BRIDGE_KEY=
CMOOC_WORKBENCH_ORIGIN=http://127.0.0.1:3050
CMOOC_PORTABLE_SERVICE_ORIGIN=http://127.0.0.1:3050
COURSE_MANIFEST_DIR=/data/course-manifests
LLM_MODE=mock
REAL_FORUM_LOGIN_URL=
CMOOC_SATOKEN=
CMOOC_PARTNER_ACCOUNT=
CMOOC_PARTNER_PASSWORD=
CMOOC_ALLOWED_FORUM_ORIGINS=
