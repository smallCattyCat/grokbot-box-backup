generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "darwin-arm64", "windows"]
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Course {
  id                    String                       @id @default(cuid())
  platformCourseId      String                       @unique
  name                  String
  sourceUrl             String?
  status                String                       @default("active")
  metadataJson          String
  lastSyncedAt          DateTime?
  createdAt             DateTime                     @default(now())
  updatedAt             DateTime                     @updatedAt
  memberships           CourseMembership[]
  posts                 ForumPost[]
  replies               ForumReply[]
  ingestionRuns         ForumIngestionRun[]
  postSnapshots         ForumPostSnapshot[]
  userSnapshots         ForumUserSnapshot[]
  userCourseProfiles    ForumUserCourseProfile[]
  utteranceAnalyses     ForumUserUtteranceAnalysis[]
  autoRuns              AutoInterventionRun[]
  autoCandidates        AutoInterventionCandidate[]
  interactionAnalyses   InteractionAnalysis[]
  tasks                 InterventionTask[]
  agentRuns             AgentRun[]
  agentContextSnapshots AgentContextSnapshot[]

  @@index([status])
  @@index([lastSyncedAt])
}

model ForumUser {
  id                     String                       @id @default(cuid())
  forumUserId            String                       @unique
  name                   String
  role                   String
  tagsJson               String
  activityLevel          Int
  emotionalState         String
  centralityScore        Float
  lastActiveAt           DateTime
  createdAt              DateTime                     @default(now())
  updatedAt              DateTime                     @updatedAt
  posts                  ForumPost[]
  replies                ForumReply[]
  tasks                  InterventionTask[]
  userSnapshots          ForumUserSnapshot[]
  profile                ForumUserProfile?
  utteranceAnalyses      ForumUserUtteranceAnalysis[]
  courseMemberships      CourseMembership[]
  courseProfiles         ForumUserCourseProfile[]
  targetContextSnapshots AgentContextSnapshot[]
}

model CourseMembership {
  id                  String    @id @default(cuid())
  courseId            String
  userId              String
  forumUserId         String
  displayName         String
  roleInCourse        String
  firstSeenAt         DateTime?
  lastSeenAt          DateTime?
  postCount           Int       @default(0)
  replyCount          Int       @default(0)
  companionReplyCount Int       @default(0)
  activityLevel       Int       @default(0)
  emotionalState      String    @default("unknown")
  centralityScore     Float     @default(0)
  personaType         String    @default("participant")
  tagsJson            String
  evidenceJson        String
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  course              Course    @relation(fields: [courseId], references: [id])
  user                ForumUser @relation(fields: [userId], references: [id])

  @@unique([courseId, userId])
  @@index([courseId])
  @@index([userId])
  @@index([forumUserId])
  @@index([personaType])
}

model AutoInterventionRun {
  id                String                      @id @default(cuid())
  courseId          String?
  forumListUrl      String
  mode              String
  status            String
  maxScanPosts      Int
  maxPublishCount   Int
  minScoreToPublish Float
  startedAt         DateTime                    @default(now())
  finishedAt        DateTime?
  reportJson        String?
  createdAt         DateTime                    @default(now())
  updatedAt         DateTime                    @updatedAt
  course            Course?                     @relation(fields: [courseId], references: [id])
  candidates        AutoInterventionCandidate[]

  @@index([courseId])
}

model AutoInterventionCandidate {
  id                 String              @id @default(cuid())
  courseId           String?
  runId              String
  postId             String
  postUrl            String
  postTitle          String
  rawExtractJson     String
  valueAnalysisJson  String?
  interventionScore  Float
  cieLevel           Int
  emotionLabel       String
  topicType          String
  interventionType   String
  targetMode         String
  targetCommentIndex Int?
  targetReason       String
  replyStrategy      String
  riskLevel          String
  reason             String
  draftReply         String?
  finalReply         String?
  safetyRisk         Int?
  status             String
  publishedUrl       String?
  screenshotPath     String?
  errorMessage       String?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  course             Course?             @relation(fields: [courseId], references: [id])
  run                AutoInterventionRun @relation(fields: [runId], references: [id])
  post               ForumPost           @relation(fields: [postId], references: [id])
  task               InterventionTask?

  @@index([courseId])
  @@index([runId])
  @@index([postId])
  @@index([postUrl])
  @@index([status])
}

model ForumPost {
  id                    String                       @id @default(cuid())
  courseId              String?
  sourceKind            String                       @default("unknown")
  forumPostId           String                       @unique
  authorId              String
  title                 String
  content               String
  url                   String
  replyCount            Int                          @default(0)
  likeCount             Int                          @default(0)
  viewCount             Int                          @default(0)
  createdAt             DateTime
  updatedAt             DateTime                     @updatedAt
  lastReplyAt           DateTime?
  course                Course?                      @relation(fields: [courseId], references: [id])
  author                ForumUser                    @relation(fields: [authorId], references: [id])
  replies               ForumReply[]
  analysis              InteractionAnalysis?
  tasks                 InterventionTask[]
  autoCandidates        AutoInterventionCandidate[]
  agentRuns             AgentRun[]
  postSnapshots         ForumPostSnapshot[]
  utteranceAnalyses     ForumUserUtteranceAnalysis[]
  agentContextSnapshots AgentContextSnapshot[]

  @@index([courseId])
  @@index([sourceKind])
  @@index([authorId])
}

model ForumIngestionRun {
  id            String              @id @default(cuid())
  courseId      String?
  sourceUrl     String
  sourceType    String
  status        String
  postCount     Int                 @default(0)
  replyCount    Int                 @default(0)
  userCount     Int                 @default(0)
  startedAt     DateTime            @default(now())
  finishedAt    DateTime?
  metadataJson  String?
  errorMessage  String?
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
  course        Course?             @relation(fields: [courseId], references: [id])
  postSnapshots ForumPostSnapshot[]
  userSnapshots ForumUserSnapshot[]

  @@index([courseId])
  @@index([sourceUrl])
  @@index([status])
  @@index([createdAt])
}

model ForumPostSnapshot {
  id            String            @id @default(cuid())
  courseId      String?
  runId         String
  postId        String
  forumPostId   String
  columnId      String?
  columnName    String?
  title         String
  url           String
  replyCount    Int
  likeCount     Int
  viewCount     Int
  contentLength Int
  lastReplyAt   DateTime?
  rawJson       String
  createdAt     DateTime          @default(now())
  course        Course?           @relation(fields: [courseId], references: [id])
  run           ForumIngestionRun @relation(fields: [runId], references: [id])
  post          ForumPost         @relation(fields: [postId], references: [id])

  @@index([courseId])
  @@index([runId])
  @@index([postId])
  @@index([forumPostId])
  @@index([columnId])
  @@index([createdAt])
}

model ForumUserSnapshot {
  id                  String            @id @default(cuid())
  courseId            String?
  runId               String
  userId              String
  forumUserId         String
  displayName         String
  role                String
  postCount           Int
  replyCount          Int
  companionReplyCount Int
  activityLevel       Int
  emotionalState      String
  centralityScore     Float
  firstSeenAt         DateTime?
  lastSeenAt          DateTime?
  tagsJson            String
  evidenceJson        String
  createdAt           DateTime          @default(now())
  course              Course?           @relation(fields: [courseId], references: [id])
  run                 ForumIngestionRun @relation(fields: [runId], references: [id])
  user                ForumUser         @relation(fields: [userId], references: [id])

  @@index([courseId])
  @@index([runId])
  @@index([userId])
  @@index([forumUserId])
  @@index([createdAt])
}

model ForumUserProfile {
  id                       String    @id @default(cuid())
  userId                   String    @unique
  forumUserId              String
  displayName              String
  role                     String
  sourceRunId              String?
  utteranceCount           Int       @default(0)
  postCount                Int       @default(0)
  replyCount               Int       @default(0)
  nestedReplyCount         Int       @default(0)
  outgoingInteractionCount Int       @default(0)
  incomingInteractionCount Int       @default(0)
  avgCieLevel              Float     @default(0)
  avgCieConfidence         Float     @default(0)
  dominantIamPhase         Int       @default(1)
  dominantKnowledgePhase   String    @default("unknown")
  dominantEmotion          String    @default("unknown")
  avgConfusionScore        Float     @default(0)
  avgUrgencyScore          Float     @default(0)
  questionRatio            Float     @default(0)
  resourceNeedRatio        Float     @default(0)
  highCieRatio             Float     @default(0)
  shallowReplyRatio        Float     @default(0)
  centralityScore          Float     @default(0)
  personaType              String    @default("participant")
  riskFlagsJson            String
  interestTermsJson        String
  evidenceJson             String
  profileSummary           String
  generatedAt              DateTime  @default(now())
  updatedAt                DateTime  @updatedAt
  user                     ForumUser @relation(fields: [userId], references: [id])

  @@index([forumUserId])
  @@index([sourceRunId])
  @@index([personaType])
  @@index([generatedAt])
}

model ForumUserCourseProfile {
  id                       String    @id @default(cuid())
  courseId                 String
  userId                   String
  forumUserId              String
  displayName              String
  role                     String
  sourceRunId              String?
  utteranceCount           Int       @default(0)
  postCount                Int       @default(0)
  replyCount               Int       @default(0)
  nestedReplyCount         Int       @default(0)
  outgoingInteractionCount Int       @default(0)
  incomingInteractionCount Int       @default(0)
  avgCieLevel              Float     @default(0)
  avgCieConfidence         Float     @default(0)
  dominantIamPhase         Int       @default(1)
  dominantKnowledgePhase   String    @default("unknown")
  dominantEmotion          String    @default("unknown")
  avgConfusionScore        Float     @default(0)
  avgUrgencyScore          Float     @default(0)
  questionRatio            Float     @default(0)
  resourceNeedRatio        Float     @default(0)
  highCieRatio             Float     @default(0)
  shallowReplyRatio        Float     @default(0)
  centralityScore          Float     @default(0)
  personaType              String    @default("participant")
  riskFlagsJson            String
  interestTermsJson        String
  evidenceJson             String
  profileSummary           String
  generatedAt              DateTime  @default(now())
  updatedAt                DateTime  @updatedAt
  course                   Course    @relation(fields: [courseId], references: [id])
  user                     ForumUser @relation(fields: [userId], references: [id])

  @@unique([courseId, userId])
  @@index([courseId])
  @@index([userId])
  @@index([forumUserId])
  @@index([sourceRunId])
  @@index([personaType])
  @@index([generatedAt])
}

model ForumUserUtteranceAnalysis {
  id               String      @id @default(cuid())
  courseId         String?
  utteranceKey     String      @unique
  userId           String
  forumUserId      String
  postId           String?
  replyId          String?
  sourceRunId      String?
  sourceKind       String      @default("unknown")
  utteranceType    String
  columnName       String?
  title            String?
  contentPreview   String
  contentLength    Int
  depth            Int         @default(0)
  targetUserId     String?
  cieLevel         Int
  cieLabel         String
  cieConfidence    Float
  iamPhase         Int
  knowledgePhase   String
  emotionLabel     String
  confusionScore   Int
  urgencyScore     Int
  isQuestion       Boolean
  resourceNeed     Boolean
  shallowReply     Boolean
  needsHumanReview Boolean
  matchedWordsJson String
  topicTermsJson   String
  sourceCreatedAt  DateTime?
  createdAt        DateTime    @default(now())
  analyzedAt       DateTime    @default(now())
  course           Course?     @relation(fields: [courseId], references: [id])
  user             ForumUser   @relation(fields: [userId], references: [id])
  post             ForumPost?  @relation(fields: [postId], references: [id])
  reply            ForumReply? @relation(fields: [replyId], references: [id])

  @@index([courseId])
  @@index([userId])
  @@index([forumUserId])
  @@index([postId])
  @@index([replyId])
  @@index([sourceRunId])
  @@index([sourceKind])
  @@index([utteranceType])
  @@index([cieLevel])
  @@index([iamPhase])
  @@index([sourceCreatedAt])
}

model ForumReply {
  id                    String                       @id @default(cuid())
  courseId              String?
  sourceKind            String                       @default("unknown")
  forumReplyId          String                       @unique
  platformReplyId       String?
  parentPlatformReplyId String?
  postId                String
  authorId              String
  targetUserId          String?
  depth                 Int                          @default(0)
  content               String
  isCompanionReply      Boolean                      @default(false)
  companionType         String?
  createdAt             DateTime                     @default(now())
  course                Course?                      @relation(fields: [courseId], references: [id])
  post                  ForumPost                    @relation(fields: [postId], references: [id])
  author                ForumUser                    @relation(fields: [authorId], references: [id])
  utteranceAnalyses     ForumUserUtteranceAnalysis[]

  @@index([courseId])
  @@index([sourceKind])
  @@index([postId])
  @@index([authorId])
  @@index([targetUserId])
  @@index([platformReplyId])
  @@index([parentPlatformReplyId])
  @@index([depth])
}

model InteractionAnalysis {
  id                   String    @id @default(cuid())
  courseId             String?
  postId               String    @unique
  cieLevel             Int
  cieLabel             String
  emotionLabel         String
  topicRelevance       Float
  cognitiveDepth       Float
  discussionPotential  Float
  unansweredHours      Float
  isolatedLearnerScore Float
  duplicateScore       Float
  analyzedAt           DateTime  @default(now())
  course               Course?   @relation(fields: [courseId], references: [id])
  post                 ForumPost @relation(fields: [postId], references: [id])

  @@index([courseId])
}

model InterventionTask {
  id                       String                     @id @default(cuid())
  courseId                 String?
  postId                   String
  targetUserId             String
  interventionType         String
  publishTarget            String                     @default("post_comment")
  targetCommentStrategy    String?
  targetCommentIndex       Int?
  targetPlatformReplyId    String?
  targetCommentContentHash String?
  targetCommentPreview     String?
  priorityScore            Float
  status                   String
  draftContent             String?
  finalContent             String?
  safetyRisk               Int?
  safetyResult             String?
  publishedUrl             String?
  screenshotPath           String?
  errorMessage             String?
  retryCount               Int                        @default(0)
  sourceCandidateId        String?                    @unique
  contentHash              String?
  targetHash               String?
  policyDecisionJson       String?
  policyVersion            String?
  safetyCheckedAt          DateTime?
  createdAt                DateTime                   @default(now())
  updatedAt                DateTime                   @updatedAt
  publishedAt              DateTime?
  course                   Course?                    @relation(fields: [courseId], references: [id])
  post                     ForumPost                  @relation(fields: [postId], references: [id])
  targetUser               ForumUser                  @relation(fields: [targetUserId], references: [id])
  sourceCandidate          AutoInterventionCandidate? @relation(fields: [sourceCandidateId], references: [id], onDelete: SetNull)
  agentRuns                AgentRun[]
  publishAttempts          PublishAttempt[]
  publishAuthorizations    PublishAuthorization[]
  contextSnapshots         AgentContextSnapshot[]

  @@index([courseId])
  @@index([postId])
  @@index([targetUserId])
  @@index([status])
  @@index([contentHash])
  @@index([targetPlatformReplyId])
}

model AgentRun {
  id         String            @id @default(cuid())
  courseId   String?
  taskId     String?
  postId     String?
  agentName  String
  inputJson  String
  outputJson String
  status     String
  startedAt  DateTime          @default(now())
  finishedAt DateTime?
  course     Course?           @relation(fields: [courseId], references: [id])
  task       InterventionTask? @relation(fields: [taskId], references: [id])
  post       ForumPost?        @relation(fields: [postId], references: [id])

  @@index([courseId])
  @@index([taskId])
  @@index([postId])
}

model AgentContextSnapshot {
  id                       String           @id @default(cuid())
  courseId                 String?
  taskId                   String
  postId                   String
  targetUserId             String
  sourceRunId              String?
  companionType            String
  revision                 Int
  asOfAt                   DateTime
  observationSchemaVersion String
  inferenceModelVersion    String
  expressionPolicyVersion  String
  observationJson          String
  inferenceJson            String
  expressionJson           String
  futureInformationUsed    Boolean          @default(false)
  createdAt                DateTime         @default(now())
  course                   Course?          @relation(fields: [courseId], references: [id])
  task                     InterventionTask @relation(fields: [taskId], references: [id])
  post                     ForumPost        @relation(fields: [postId], references: [id])
  targetUser               ForumUser        @relation(fields: [targetUserId], references: [id])

  @@unique([taskId, revision])
  @@index([courseId])
  @@index([taskId])
  @@index([postId])
  @@index([targetUserId])
  @@index([sourceRunId])
  @@index([asOfAt])
  @@index([companionType])
}

model CompanionProfile {
  id                     String   @id @default(cuid())
  name                   String
  type                   String   @unique
  persona                String
  tone                   String
  roleBoundary           String
  currentMentalStateJson String
  active                 Boolean  @default(true)
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt
}

model PublishAuthorization {
  id           String           @id @default(cuid())
  taskId       String
  kind         String           @default("single")
  status       String           @default("active")
  contentHash  String
  targetHash   String
  expiresAt    DateTime
  maxUses      Int              @default(1)
  usedCount    Int              @default(0)
  metadataJson String           @default("{}")
  authorizedAt DateTime         @default(now())
  consumedAt   DateTime?
  revokedAt    DateTime?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  task         InterventionTask @relation(fields: [taskId], references: [id], onDelete: Cascade)
  attempts     PublishAttempt[]

  @@index([taskId, status])
  @@index([expiresAt])
}

model PublishAttempt {
  id              String                @id @default(cuid())
  taskId          String
  authorizationId String?
  action          String                @default("publish")
  status          String
  message         String
  contentHash     String?
  targetHash      String?
  idempotencyKey  String?               @unique
  transport       String?
  remoteUrl       String?
  screenshotPath  String?
  evidenceJson    String?
  errorCode       String?
  startedAt       DateTime?
  finishedAt      DateTime?
  createdAt       DateTime              @default(now())
  // Publish attempts are durable execution evidence. A task with attempts
  // must not be deleted and silently erase that history.
  task            InterventionTask      @relation(fields: [taskId], references: [id], onDelete: Restrict)
  authorization   PublishAuthorization? @relation(fields: [authorizationId], references: [id], onDelete: SetNull)

  @@index([taskId])
  @@index([authorizationId])
  @@index([status])
  @@map("PublishLog")
}

model ForumSetting {
  id                   String   @id @default("default")
  forumBaseUrl         String
  loginUrl             String
  postUrlPattern       String
  replyEditorSelector  String
  replySubmitSelector  String
  replySuccessSelector String
  realPublishEnabled   Boolean  @default(false)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
}

model AutonomyCourseManifest {
  alias                  String                @id
  manifestHash           String                @unique
  platformId             String
  adapterId              String?
  platformCourseRefHash  String
  canonicalLocatorHash   String
  identityKeyFingerprint String
  allowedOrigin          String
  timeZone               String
  defaultMode            String
  policyVersion          String
  enabled                Boolean               @default(true)
  realPublishEnabled     Boolean               @default(false)
  createdAt              DateTime              @default(now())
  updatedAt              DateTime              @updatedAt
  schedules              OperationSchedule[]
  policies               AutonomyPolicy[]
  invocations            ScheduledInvocation[]
  communityMemoryRevisions CommunityInquiryMemoryRevision[]
  communityTeacherJudgementOutbox CommunityTeacherJudgementOutbox[]

  @@index([enabled])
  @@index([platformId, adapterId])
}

model OperationSchedule {
  id              String                 @id @default(cuid())
  courseAlias     String
  scheduleKey     String                 @unique
  mode            String
  intervalMinutes Int
  timeZone        String
  enabled         Boolean                @default(true)
  nextRunAt       DateTime?
  budgetJson      String
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt
  course          AutonomyCourseManifest @relation(fields: [courseAlias], references: [alias], onDelete: Restrict)
  invocations     ScheduledInvocation[]

  @@index([courseAlias, enabled])
  @@index([nextRunAt])
}

model AutonomyPolicy {
  id                 String                 @id @default(cuid())
  courseAlias        String
  version            String
  status             String
  mode               String
  allowedActionsJson String
  budgetJson         String
  policyHash         String                 @unique
  validFrom          DateTime
  validUntil         DateTime
  revokedAt          DateTime?
  emergencyHalt      Boolean                @default(false)
  realPublishEnabled Boolean                @default(false)
  createdAt          DateTime               @default(now())
  updatedAt          DateTime               @updatedAt
  course             AutonomyCourseManifest @relation(fields: [courseAlias], references: [alias], onDelete: Restrict)

  @@unique([courseAlias, version])
  @@index([courseAlias, status])
  @@index([validUntil])
}

/// Course-level operational governance is an upper-bound scheduler/tick
/// policy. It is intentionally separate from AutonomyPolicy (the execution
/// authority used by ExecutionPermit) and never contains actions or publish
/// capabilities. Rows are immutable append-only policy events: status changes
/// require a new version rather than an in-place update.
model CourseOperationGovernancePolicy {
  id                  String                               @id @default(cuid())
  courseAlias         String
  version             String
  baseManifestHash    String
  status              String
  mode                String
  dailySlotLimit      Int
  perTickActionLimit  Int
  authorTouchLimit30d Int
  minIntervalMinutes  Int
  validFrom           DateTime
  validUntil          DateTime
  emergencyHalt       Boolean                              @default(false)
  governanceHash      String                               @unique
  containsForumText   Boolean                              @default(false)
  createdAt           DateTime                             @default(now())
  updatedAt           DateTime                             @updatedAt
  outgoingTransition  CourseOperationGovernanceTransition? @relation("GovernanceTransitionFrom")
  incomingTransition  CourseOperationGovernanceTransition? @relation("GovernanceTransitionTo")

  @@unique([courseAlias, version])
  @@index([courseAlias, status, validUntil])
  @@index([courseAlias, baseManifestHash])
}

/// Immutable lineage between two full governance policy snapshots. The
/// transition is a local course-operation control event only; it never grants
/// STAGE, AUTO, editor, notification, or publish authority.
model CourseOperationGovernanceTransition {
  id                   String                          @id @default(cuid())
  schemaVersion        String
  courseAlias          String
  transitionKey        String
  action               String
  fromGovernanceHash   String                          @unique
  toGovernanceHash     String                          @unique
  expectedManifestHash String
  effectiveAt          DateTime
  reasonCode           String
  eventHash            String                          @unique
  containsForumText    Boolean                         @default(false)
  createdAt            DateTime                        @default(now())
  fromPolicy           CourseOperationGovernancePolicy @relation("GovernanceTransitionFrom", fields: [fromGovernanceHash], references: [governanceHash], onDelete: Restrict, onUpdate: Restrict)
  toPolicy             CourseOperationGovernancePolicy @relation("GovernanceTransitionTo", fields: [toGovernanceHash], references: [governanceHash], onDelete: Restrict, onUpdate: Restrict)

  @@unique([courseAlias, transitionKey])
  @@index([courseAlias, createdAt])
  @@index([courseAlias, effectiveAt])
}

model ScheduledInvocation {
  id                     String                  @id @default(cuid())
  invocationKey          String                  @unique
  courseAlias            String
  scheduleId             String?
  manifestHash           String
  governancePolicyId     String?
  governanceVersion      String?
  governanceHash         String?
  governanceLimitsJson   String?
  scheduledFor           DateTime
  mode                   String
  status                 String
  phase                  String
  leaseOwner             String?
  leaseExpiresAt         DateTime?
  heartbeatAt            DateTime?
  attempt                Int                     @default(0)
  recoveredFromId        String?
  startedAt              DateTime?
  finishedAt             DateTime?
  summaryJson            String?
  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt
  course                 AutonomyCourseManifest  @relation(fields: [courseAlias], references: [alias], onDelete: Restrict)
  schedule               OperationSchedule?      @relation(fields: [scheduleId], references: [id], onDelete: Restrict)
  scanRun                CourseScanRun?
  observations           AutonomyObservation[]
  worldSnapshot          CourseWorldSnapshot?
  candidateSet           CandidateSet?
  schedulingLedger       SchedulingLedger?
  budgetReservations     BudgetReservation[]
  decisions              AutonomyDecision[]
  executionAccountLeases ExecutionAccountLease[]
  decisionTape           DecisionTapeEntry[]
  reviewEvents           ReviewEvent[]
  incidents              AutonomyIncident[]
  communityMemoryRevisions CommunityInquiryMemoryRevision[]
  communityTeacherJudgementOutbox CommunityTeacherJudgementOutbox[]

  @@unique([courseAlias, scheduledFor, mode])
  // scheduleId remains nullable for historical invocations whose scheduler
  // evidence predates durable schedule binding. SQLite permits multiple NULLs
  // in this unique index; no unverifiable backfill is performed.
  @@unique([scheduleId, scheduledFor])
  @@index([courseAlias, status])
  @@index([governanceHash])
  @@index([leaseExpiresAt])
  @@index([scheduledFor])
}

model AutonomyWorkerWakeReceipt {
  id                  String    @id @default(cuid())
  source              String
  runtimeVersion      String
  startedAt           DateTime
  finishedAt          DateTime?
  status              String
  reasonCode          String
  exitCode            Int?
  countsJson          String
  sourceTruncated     Boolean   @default(false)
  taskSetHash         String
  summaryHash         String
