/// Immutable, body-free CommunityInquiryMemoryV1 revisions. The JSON is the
/// canonical contract payload; the duplicated routing fields make exact
/// snapshot queries possible without treating this table as a new course fact
/// source. Status changes are represented by a new revision, never an update.
model CommunityInquiryMemoryRevision {
  id                    String                         @id @default(cuid())
  schemaVersion         String
  memoryKey             String
  version               Int
  status                String
  courseAlias           String
  invocationId          String
  worldSnapshotId       String
  graphSnapshotId       String
  candidateSetId        String
  asOfAt                DateTime
  worldHash             String
  graphHash             String
  candidateSetHash      String
  memoryJson            String
  contentHash           String                         @unique
  recordedAt            DateTime
  validFrom             DateTime?
  validThrough          DateTime?
  supersedesMemoryKey   String?
  supersedesVersion     Int?
  supersedesContentHash String?
  containsForumText     Boolean                        @default(false)
  containsDirectIdentity Boolean                       @default(false)
  assertsCausality      Boolean                        @default(false)
  createdAt             DateTime                       @default(now())
  course                AutonomyCourseManifest         @relation(fields: [courseAlias], references: [alias], onDelete: Restrict, onUpdate: Restrict)
  invocation            ScheduledInvocation            @relation(fields: [invocationId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  worldSnapshot         CourseWorldSnapshot            @relation(fields: [worldSnapshotId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  graphSnapshot         CourseContentGraphSnapshot     @relation(fields: [graphSnapshotId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  candidateSet          CandidateSet                   @relation(fields: [candidateSetId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  reviews               CommunityInquiryMemoryReview[]

  @@unique([memoryKey, version])
  @@index([courseAlias, memoryKey, version])
  @@index([candidateSetId, asOfAt])
  @@index([invocationId])
  @@index([status, createdAt])
}

/// Append-only owner/teacher review events for a memory revision. This table
/// is a gate/audit stream, not a mutable approval flag. The reader accepts an
/// active revision only when its review head is explicitly approved.
model CommunityInquiryMemoryReview {
  id                String                         @id @default(cuid())
  memoryRevisionId  String
  courseAlias       String
  memoryKey         String
  version           Int
  contentHash       String
  sequence          Int
  action            String
  reviewerRole      String
  reviewerRefHash   String
  reasonCode        String
  previousReviewHash String?
  reviewHash        String                         @unique
  idempotencyKeyHash String                        @unique
  containsForumText Boolean                        @default(false)
  createdAt         DateTime                       @default(now())
  revision          CommunityInquiryMemoryRevision @relation(fields: [memoryRevisionId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([memoryRevisionId, sequence])
  @@index([memoryKey, version, sequence])
  @@index([contentHash, action])
}

/// Append-only, body-free cross-store promotion events.  This is an outbox
/// ledger, not a mutable approval flag: prepared/autonomy_appended/
/// browser_mirrored/needs_review are appended as new rows.
model CommunityTeacherJudgementOutbox {
  id                   String              @id @default(cuid())
  schemaVersion        String
  operationKey         String
  sequence             Int
  state                String
  judgementHash        String
  judgementJson        String
  courseAlias          String
  browserCourseId      String
  browserRunRef        String
  invocationId         String
  decisionKey          String
  candidateKey         String
  worldSnapshotId      String
  graphSnapshotId      String
  candidateSetId       String
  asOfAt               DateTime
  worldHash            String
  graphHash            String
  candidateSetHash     String
  bindingHash          String
  browserTapeRef       String
  browserTapeHeadHash  String
  browserRunRevision   Int
  browserObservationHash String
  previousEventHash    String?
  eventHash            String              @unique
  errorCode            String?
