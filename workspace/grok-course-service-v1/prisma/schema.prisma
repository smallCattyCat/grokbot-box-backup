}

model WorkbenchTask {
  id                 String                             @id
  title              String
  status             String
  contextSnapshotId  String?
  createdAt          DateTime
  updatedAt          DateTime                           @updatedAt
  completedAt        DateTime?
  contextSnapshot    WorkbenchContextSnapshot?          @relation(fields: [contextSnapshotId], references: [id], onDelete: SetNull)
  runs               WorkbenchRunRecord[]
  safeObjective      WorkbenchSafeTaskObjective?
  planRevisions      WorkbenchPlanRevisionRecord[]
  toolCalls          WorkbenchToolCallRecord[]
  artifactVersions   WorkbenchArtifactVersionRecord[]
  artifactSelections WorkbenchArtifactSelectionRecord[]
  verifications      WorkbenchVerificationRecord[]
  executionLeases    WorkbenchExecutionLease[]
  courseToolActions  WorkbenchCourseToolActionRecord[]
  stageTransactions  WorkbenchStageTransactionRecord[]

  @@index([status, updatedAt])
  @@index([contextSnapshotId])
}

model WorkbenchRunRecord {
  id                String                            @id
  taskId            String
  schemaVersion     String
  source            String
  status            String
  projectLabel      String
  snapshotJson      String
  errorCode         String?
  recoveryState     String?
  createdAt         DateTime
  updatedAt         DateTime
  finishedAt        DateTime?
  task              WorkbenchTask                     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  events            WorkbenchEventRecord[]
  artifacts         WorkbenchArtifactRecord[]
  planRevisions     WorkbenchPlanRevisionRecord[]
  toolCalls         WorkbenchToolCallRecord[]
  artifactVersions  WorkbenchArtifactVersionRecord[]
  verifications     WorkbenchVerificationRecord[]
  executionLeases   WorkbenchExecutionLease[]
  courseToolActions WorkbenchCourseToolActionRecord[]
  stageTransactions WorkbenchStageTransactionRecord[]

  @@index([status, updatedAt])
  @@index([taskId])
}

model WorkbenchEventRecord {
  id         String             @id @default(cuid())
  runId      String
  sequence   Int
  kind       String
  status     String
  title      String
  summary    String?
  agentLabel String?
  agentRole  String?
  createdAt  DateTime
  run        WorkbenchRunRecord @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@unique([runId, sequence])
  @@index([runId, createdAt])
}

model WorkbenchArtifactRecord {
  id           String             @id @default(cuid())
  runId        String
  artifactId   String
  label        String
  relativePath String
  kind         String
  status       String
  observedAt   DateTime
  run          WorkbenchRunRecord @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@unique([runId, artifactId])
}

/// Classified task intent only. Raw prompts and user-authored objective text
/// remain transient and must never be copied into this table.
model WorkbenchSafeTaskObjective {
  id                 String        @id
  taskId             String        @unique
  schemaVersion      String
  objectiveHash      String
  safeSummary        String
  structuredGoalJson String
  source             String
  expiresAt          DateTime?
  createdAt          DateTime      @default(now())
  task               WorkbenchTask @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([objectiveHash])
  @@index([expiresAt])
}

/// A model plan is only a proposal. Rows here are immutable canonical plans
/// emitted by the server-side compiler and validator.
model WorkbenchPlanRevisionRecord {
  id                String                            @id
  taskId            String
  runId             String
  revision          Int
  objectiveHash     String
  source            String
  compilerVersion   String
  proposalHash      String?
  safeSummary       String
  createdAt         DateTime                          @default(now())
  task              WorkbenchTask                     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  run               WorkbenchRunRecord                @relation(fields: [runId], references: [id], onDelete: Cascade)
  steps             WorkbenchPlanStepRecord[]
  courseToolActions WorkbenchCourseToolActionRecord[]
  stageTransactions WorkbenchStageTransactionRecord[]

  @@unique([taskId, revision])
  @@index([runId, createdAt])
  @@index([objectiveHash])
}

model WorkbenchPlanStepRecord {
  id                 String                            @id
  planRevisionId     String
  ordinal            Int
  status             String
  toolName           String
  toolVersion        String
  dependencyIdsJson  String
  inputRefsJson      String
  preconditionsJson  String
  postconditionsJson String
  effectClass        String
  requiredCapability String
  acceptanceJson     String
  replanPolicyJson   String
  safeSummary        String
  startedAt          DateTime?
  completedAt        DateTime?
  createdAt          DateTime                          @default(now())
  planRevision       WorkbenchPlanRevisionRecord       @relation(fields: [planRevisionId], references: [id], onDelete: Cascade)
  toolCalls          WorkbenchToolCallRecord[]
  executionLeases    WorkbenchExecutionLease[]
  courseToolActions  WorkbenchCourseToolActionRecord[]
  stageTransactions  WorkbenchStageTransactionRecord[]

  @@unique([planRevisionId, ordinal])
  @@index([planRevisionId, status])
  @@index([toolName, toolVersion])
}

model WorkbenchExecutionLease {
  id               String                    @id
  taskId           String
  runId            String
  stepId           String?
  scopeKey         String
  ownerInstanceId  String
  generation       Int
  fencingTokenHash String
  status           String
  acquiredAt       DateTime
  heartbeatAt      DateTime
  expiresAt        DateTime
  releasedAt       DateTime?
  createdAt        DateTime                  @default(now())
  updatedAt        DateTime                  @updatedAt
  task             WorkbenchTask             @relation(fields: [taskId], references: [id], onDelete: Cascade)
  run              WorkbenchRunRecord        @relation(fields: [runId], references: [id], onDelete: Cascade)
  step             WorkbenchPlanStepRecord?  @relation(fields: [stepId], references: [id], onDelete: Cascade)
  toolCalls        WorkbenchToolCallRecord[]

  @@unique([runId, scopeKey])
  @@index([status, expiresAt])
  @@index([taskId, runId])
  @@index([stepId])
}

model WorkbenchToolCallRecord {
  id                String                            @id
  taskId            String
  runId             String
  stepId            String
  executionLeaseId  String
  parentCallId      String?
  toolName          String
  toolVersion       String
  capability        String
  effectClass       String
  safeInputSummary  String
  inputHash         String
  idempotencyKey    String
  attempt           Int
  grantRef          String?
  leaseGeneration   Int
  fencingTokenHash  String
  status            String
  causationId       String?
  createdAt         DateTime                          @default(now())
  completedAt       DateTime?
  task              WorkbenchTask                     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  run               WorkbenchRunRecord                @relation(fields: [runId], references: [id], onDelete: Cascade)
  step              WorkbenchPlanStepRecord           @relation(fields: [stepId], references: [id], onDelete: Cascade)
  executionLease    WorkbenchExecutionLease           @relation(fields: [executionLeaseId], references: [id], onDelete: Restrict)
  parentCall        WorkbenchToolCallRecord?          @relation("WorkbenchToolCallParent", fields: [parentCallId], references: [id], onDelete: SetNull)
  childCalls        WorkbenchToolCallRecord[]         @relation("WorkbenchToolCallParent")
  receipt           WorkbenchToolReceiptRecord?
  artifactVersions  WorkbenchArtifactVersionRecord[]
  stageTransactions WorkbenchStageTransactionRecord[]

  @@unique([toolName, idempotencyKey, attempt])
  @@index([taskId, runId, createdAt])
  @@index([stepId, status])
  @@index([executionLeaseId, leaseGeneration])
  @@index([parentCallId])
}

model WorkbenchToolReceiptRecord {
  id                String                  @id
  callId            String                  @unique
  status            String
  safeOutputSummary String
  outputHash        String
  evidenceRefsJson  String
  beforeRefJson     String?
  afterRefJson      String?
  verificationId    String?
  compensationRef   String?
  containsForumText Boolean                 @default(false)
  containsIdentity  Boolean                 @default(false)
  observedAt        DateTime
  createdAt         DateTime                @default(now())
  call              WorkbenchToolCallRecord @relation(fields: [callId], references: [id], onDelete: Cascade)

  @@index([status, observedAt])
  @@index([verificationId])
}

model WorkbenchArtifactVersionRecord {
  id                     String                   @id
  taskId                 String
  runId                  String
  artifactId             String
  version                Int
  schemaVersion          String
  artifactKind           String
  contentClass           String
  contentHash            String
  draftBodyHash          String?
  contentRef             String?
  safeSummary            String
  metadataJson           String
  sourceRefsJson         String
  regenerationRecipeJson String?
  createdByCallId        String?
  expiresAt              DateTime?
  createdAt              DateTime                 @default(now())
  task                   WorkbenchTask            @relation(fields: [taskId], references: [id], onDelete: Cascade)
  run                    WorkbenchRunRecord       @relation(fields: [runId], references: [id], onDelete: Cascade)
  createdByCall          WorkbenchToolCallRecord? @relation(fields: [createdByCallId], references: [id], onDelete: SetNull)

  @@unique([artifactId, version])
  @@index([taskId, artifactId, createdAt])
  @@index([runId, createdAt])
  @@index([createdByCallId])
  @@index([contentHash])
}

/// Current task-scoped pointer to one immutable logical artifact version.
/// The pointer advances only through generation + selectionHash CAS; artifact
/// bodies remain outside this table.
model WorkbenchArtifactSelectionRecord {
  id             String        @id
  taskId         String
  runId          String
  artifactId     String
  versionId      String
  versionRef     String
  version        Int
  contentHash    String
  draftBodyHash  String?
  verificationId String
  generation     Int
  selectionHash  String
  selectedAt     DateTime
  updatedAt      DateTime
  task           WorkbenchTask @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@unique([taskId, artifactId])
  @@index([versionId])
  @@index([verificationId])
  @@index([runId, selectedAt])
  @@index([selectionHash])
}

model WorkbenchVerificationRecord {
  id                String             @id
  taskId            String
  runId             String
  subjectType       String
  subjectId         String
  verifier          String
  verifierVersion   String
  status            String
  safeSummary       String
  checksJson        String
  evidenceRefsJson  String
  observedAt        DateTime
  expiresAt         DateTime?
  containsForumText Boolean            @default(false)
  containsIdentity  Boolean            @default(false)
  createdAt         DateTime           @default(now())
  task              WorkbenchTask      @relation(fields: [taskId], references: [id], onDelete: Cascade)
  run               WorkbenchRunRecord @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@index([taskId, subjectType, subjectId])
  @@index([runId, status, observedAt])
  @@index([expiresAt])
}

/// Server-prepared L3 STAGE action. The durable projection contains only
/// hashes, safe business parameters and exact execution binding fields; forum
/// bodies, identities, credentials, paths and raw platform identifiers are
/// forbidden by the application store and database boundary.
model WorkbenchCourseToolActionRecord {
  id                  String                            @id
  schemaVersion       String
  taskId              String
  runId               String
  planRevisionId      String
  stepId              String
  callId              String                            @unique
  toolName            String
  toolVersion         String
  capability          String
  effectClass         String
  courseScopeHash     String
  inputHash           String
  idempotencyKeyHash  String
  policyVersion       String
  attempt             Int
  businessInputJson   String
  safeSummary         String
  bindingHash         String                            @unique
  approvalHash        String                            @unique
  grantRef            String                            @unique
  validFrom           DateTime
  expiresAt           DateTime
  oneShot             Boolean                           @default(true)
  realPublishEnabled  Boolean                           @default(false)
  status              String
  statusReasonCode    String
  terminalReceiptHash String?
  reconciliationHash  String?
  /// Safe, non-replayable recovery reference returned by an ambiguous trusted
  /// STAGE attempt. It contains no draft body, identity, credential or token.
  compensationRef     String?
  /// Immediate action lineage. Recovery actions point to the ambiguous STAGE
  /// action; ordinary STAGE actions keep this null.
  parentActionId      String?
  /// Exact action whose unknown outcome this action reconciles. Kept separate
  /// from parentActionId so recovery semantics remain explicit and auditable.
  recoveryOfActionId  String?
  containsForumText   Boolean                           @default(false)
  containsIdentity    Boolean                           @default(false)
  containsSecrets     Boolean                           @default(false)
  preparedAt          DateTime
  approvalRequestedAt DateTime?
  approvedAt          DateTime?
  executionStartedAt  DateTime?
  completedAt         DateTime?
  createdAt           DateTime                          @default(now())
  updatedAt           DateTime                          @updatedAt
  task                WorkbenchTask                     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  run                 WorkbenchRunRecord                @relation(fields: [runId], references: [id], onDelete: Cascade)
  planRevision        WorkbenchPlanRevisionRecord       @relation(fields: [planRevisionId], references: [id], onDelete: Cascade)
  step                WorkbenchPlanStepRecord           @relation(fields: [stepId], references: [id], onDelete: Cascade)
  grant               WorkbenchCourseToolGrantRecord?
  parentAction        WorkbenchCourseToolActionRecord?  @relation("WorkbenchCourseToolActionParent", fields: [parentActionId], references: [id], onDelete: SetNull)
  childActions        WorkbenchCourseToolActionRecord[] @relation("WorkbenchCourseToolActionParent")
  recoveryOfAction    WorkbenchCourseToolActionRecord?  @relation("WorkbenchCourseToolActionRecovery", fields: [recoveryOfActionId], references: [id], onDelete: SetNull)
  recoveryActions     WorkbenchCourseToolActionRecord[] @relation("WorkbenchCourseToolActionRecovery")

  @@index([taskId, runId, status])
  @@index([planRevisionId, stepId])
  @@index([status, expiresAt])
  @@index([toolName, toolVersion])
  @@index([parentActionId])
  @@index([recoveryOfActionId, status])
}

/// Exact-once capability grant for one server-prepared L3 STAGE action. The
/// binding is deliberately duplicated so a single UPDATE ... WHERE CAS can
/// consume the authority without trusting a mutable join projection.
model WorkbenchCourseToolGrantRecord {
  id                 String                          @id
  schemaVersion      String
  actionId           String                          @unique
  capability         String
  effectClass        String
  toolName           String
  toolVersion        String
  callId             String                          @unique
  taskId             String
  runId              String
  planRevisionId     String
  stepId             String
  courseScopeHash    String
  inputHash          String
  idempotencyKeyHash String
  policyVersion      String
  attempt            Int
  bindingHash        String                          @unique
  approvalHash       String                          @unique
  validFrom          DateTime
  expiresAt          DateTime
  oneShot            Boolean                         @default(true)
  realPublishEnabled Boolean                         @default(false)
  status             String
  consumedAt         DateTime?
  expiredAt          DateTime?
  revokedAt          DateTime?
  createdAt          DateTime                        @default(now())
  updatedAt          DateTime                        @updatedAt
  action             WorkbenchCourseToolActionRecord @relation(fields: [actionId], references: [id], onDelete: Cascade)

  @@index([status, expiresAt])
  @@index([taskId, runId])
  @@index([planRevisionId, stepId])
  @@index([toolName, toolVersion])
}

/// Body-free, restart-safe ledger for one trusted STAGE attempt. Only opaque
/// references, hashes, privacy-closed receipts and lifecycle state may enter
/// this table; draft bodies, URLs, identities and authentication material are
/// deliberately absent from the schema.
model WorkbenchStageTransactionRecord {
  stageTransactionRef         String                      @id
  schemaVersion               String
  taskId                      String
  runId                       String
  planRevisionId              String
  stepId                      String
  callId                      String                      @unique
  courseAlias                 String
  courseScopeHash             String
  manifestHash                String
  policyVersion               String
  integrityVerificationRef    String
  targetRef                   String
  opportunityId               String
  candidateKey                String
  decisionId                  String
  threadKey                   String
  targetVersionHash           String
  opportunityReceiptHash      String
  revalidationReceiptHash     String
  afterObservationReceiptHash String
  targetEvidenceRefsJson      String
  artifactVersionRef          String
  draftBodyHash               String
  runNonceHash                String
  baselineRef                 String
  baselineHash                String
  pageBindingRef              String
  pageBindingHash             String
  /// v3 only. Nullable solely so immutable v2 terminal history remains readable.
  preflightRef                String?
  preflightHash               String?
  resolvedTargetReceiptRef    String?
  resolvedTargetReceiptHash   String?
  freshObservationRef         String?
  freshObservationHash        String?
  eventSetHash                String?
  targetLocatorHash           String?
  resolvedAt                  DateTime?
  status                      String
  verifiedOutputJson          String?
  /// Set exactly once at a v3 terminal CAS. Closed, body-free stage/reconcile binding.
  terminalBindingJson         String?
  containsForumText           Boolean                     @default(false)
  containsIdentity            Boolean                     @default(false)
  containsSecrets             Boolean                     @default(false)
  createdAt                   DateTime
  updatedAt                   DateTime
  terminalAt                  DateTime?
  task                        WorkbenchTask               @relation(fields: [taskId], references: [id], onDelete: Cascade)
  run                         WorkbenchRunRecord          @relation(fields: [runId], references: [id], onDelete: Cascade)
  planRevision                WorkbenchPlanRevisionRecord @relation(fields: [planRevisionId], references: [id], onDelete: Cascade)
  step                        WorkbenchPlanStepRecord     @relation(fields: [stepId], references: [id], onDelete: Cascade)
  call                        WorkbenchToolCallRecord     @relation(fields: [callId], references: [id], onDelete: Cascade)

  @@index([taskId, runId, status])
  @@index([planRevisionId, stepId])
  @@index([courseAlias, manifestHash])
  @@index([status, updatedAt])
  @@index([artifactVersionRef])
}

/// Immutable, body-free observations of one facilitation episode. The
/// canonical episode contract is retained as JSON for replay while the
/// routing/anchor columns make source validation and course reads explicit.
model FacilitationExperienceObservation {
  id                       String   @id @default(cuid())
  schemaVersion            String
  observationKey           String
  version                  Int
  courseAlias              String
  invocationId             String
  worldSnapshotId          String
  graphSnapshotId          String
  candidateSetId           String
  asOfAt                   DateTime
  worldHash                String
  graphHash                String
  candidateSetHash         String
  sourceAnchorHash         String
  sourceAnchorJson         String
  sourceObservationHashesJson String
  observationJson          String
  observationHash          String   @unique
  observedAt               DateTime
  recordedAt               DateTime
  operationKeyHash         String   @unique
  containsForumText        Boolean  @default(false)
  containsDirectIdentity   Boolean  @default(false)
  assertsCausality         Boolean  @default(false)
  createdAt                DateTime @default(now())

  @@unique([observationKey, version])
  @@index([courseAlias, observedAt])
  @@index([courseAlias, sourceAnchorHash])
  @@index([invocationId, asOfAt])
}

/// Candidate and approved lesson revisions are append-only. Approval/review
/// state is represented by FacilitationLessonReview events rather than by
/// updating this row, so older lessons remain auditable and recoverable.
model FacilitationLessonRevision {
  id                       String   @id @default(cuid())
  schemaVersion            String
  lessonKey                String
  version                  Int
  status                   String
  courseAlias              String
  lessonJson               String
  lessonHash               String   @unique
  sourceObservationHashesJson String
  recordedAt               DateTime
  validFrom                DateTime?
  validThrough             DateTime?
  supersedesLessonKey      String?
  supersedesVersion        Int?
  supersedesLessonHash     String?
  operationKeyHash         String   @unique
  containsForumText        Boolean  @default(false)
  containsDirectIdentity   Boolean  @default(false)
  assertsCausality         Boolean  @default(false)
  createdAt                DateTime @default(now())

  @@unique([lessonKey, version])
  @@index([courseAlias, lessonKey, version])
  @@index([courseAlias, status, recordedAt])
  @@index([lessonHash, version])
}

/// Append-only server-side review events for lesson revisions. The reader
/// accepts a lesson only when its as-of review head is approved by a branded
/// server principal and no later retraction/rejection is effective.
model FacilitationLessonReview {
  id                   String   @id @default(cuid())
  lessonRevisionId     String
  courseAlias          String
  lessonKey            String
  version              Int
  lessonHash           String
  sequence             Int
  action               String
  reviewerRole         String
  reviewerRefHash      String
  reasonCode           String
  previousReviewHash   String?
  reviewHash           String   @unique
  operationKeyHash     String   @unique
  createdAt            DateTime @default(now())
  containsForumText    Boolean  @default(false)

  @@unique([lessonRevisionId, sequence])
  @@index([courseAlias, lessonKey, version, sequence])
  @@index([lessonHash, action, createdAt])
}

/// Immutable application of an accepted lesson to a later target snapshot.
/// This is an evidence record, not a publish permission or a causal outcome.
model FacilitationLessonApplication {
  id                         String   @id @default(cuid())
  schemaVersion              String
  applicationKey             String
  courseAlias                String
  lessonHash                 String
  targetInvocationId         String?
  targetWorldSnapshotId      String?
  targetGraphSnapshotId      String?
  targetCandidateSetId       String?
  targetAsOfAt               DateTime
  targetAnchorHash           String
  targetAnchorJson           String
  sourceObservationHashesJson String
  applicationJson            String
  applicationHash            String   @unique
  disposition                String
  changedFieldsJson          String
  reasonCode                 String
  decisionJson               String
  recordedAt                 DateTime
  operationKeyHash           String   @unique
  containsForumText          Boolean  @default(false)
  containsDirectIdentity     Boolean  @default(false)
  assertsCausality           Boolean  @default(false)
  createdAt                  DateTime @default(now())

  @@index([courseAlias, targetAsOfAt])
  @@index([courseAlias, lessonHash])
  @@index([applicationKey, targetAsOfAt])
}
