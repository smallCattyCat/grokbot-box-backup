  revokedAt            DateTime?
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt
  decision             AutonomyDecision @relation(fields: [decisionId], references: [id], onDelete: Restrict)

  @@index([courseAlias, status, validUntil])
  @@index([invocationId])
  @@index([policyHash])
  @@index([governanceHash])
}

