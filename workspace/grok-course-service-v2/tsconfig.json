{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["dom", "dom.iterable", "es2022"],
    "allowJs": false,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "plugins": [{ "name": "next" }],
    "paths": {
      "@/*": ["./*"]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next-stale-redesign-r2/types/**/*.ts",
    ".next-stale-r2-audit-20260831/types/**/*.ts",
    ".next-stale-workspace-r6-dev/types/**/*.ts",
    ".next-stale-workspace-r6-dev-b/types/**/*.ts",
    ".next-stale-workspace-r6-production/types/**/*.ts",
    ".next-stale-workspace-r6-production-final/types/**/*.ts",
    ".next-stale-workspace-r7-production/types/**/*.ts",
    ".next-stale-workspace-r8-production/types/**/*.ts",
    ".next-stale-workspace-r10-production-final/types/**/*.ts"
  ],
  "exclude": ["node_modules"]
}
